# AWS Bedrock Configuration (Optional for local testing with built-in fallbacks)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1
# Model ID on Amazon Bedrock:
# Claude Sonnet 5.5 (Recommended, cheaper & faster): global.anthropic.claude-sonnet-5-5 (or us.anthropic.claude-sonnet-5-5)
# Claude 3.5 Sonnet v2 (Fallback/Regional): anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5-5

# Webhook URLs
ALEXA_MCP_WEBHOOK_URL=http://localhost:8002/webhook/ring

# Frontend API Base URLs (Vite)
VITE_MCP_BASE_URL=http://localhost:8002
VITE_RING_BASE_URL=http://localhost:8001

